# Fork (AutonomousBusinessUnits/postiz): NestJS backend as a Vercel Service
# (container runtime: inbound HTTP, Function limits). See FORK.md.
FROM node:22.23.4-bookworm-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends g++ make python3 ca-certificates openssl \
 && rm -rf /var/lib/apt/lists/*
RUN npm --no-update-notifier --no-fund --global install pnpm@10.6.1
ENV CI=true
WORKDIR /app
COPY . /app
RUN pnpm install --frozen-lockfile --config.confirmModulesPurge=false
RUN NODE_OPTIONS="--max-old-space-size=4096" pnpm run build:backend \
 && rm -rf apps/frontend apps/extension apps/sdk apps/commands /root/.cache /root/.local/share/pnpm

FROM node:22.23.4-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates openssl && rm -rf /var/lib/apt/lists/*
COPY --from=build /app /app
ENV NODE_ENV=production PORT=80
EXPOSE 80
WORKDIR /app/apps/backend
CMD ["node", "--experimental-require-module", "./dist/apps/backend/src/main.js"]
