# Fork: Vercel project env (names only; values come from Baron's key store)
FRONTEND_URL=https://<domain>
NEXT_PUBLIC_BACKEND_URL=https://<domain>/api
BACKEND_INTERNAL_URL=https://<domain>/api
BACKEND_STRIP_PREFIX=/api
MAIN_URL=https://<domain>
JWT_SECRET=<random>
DATABASE_URL=<Neon pooled URL>?pgbouncer=true&connection_limit=5
STORAGE_PROVIDER=vercel-blob
BLOB_READ_WRITE_TOKEN=<from the connected Blob store>
# either Redis or the Postgres KV
REDIS_URL=<Upstash rediss://...>
KV_PROVIDER=postgres
# either Temporal Cloud or the spike bridge
TEMPORAL_ADDRESS=<ns>.<acct>.tmprl.cloud:7233
TEMPORAL_NAMESPACE=<ns>.<acct>
TEMPORAL_API_KEY=<key>
TEMPORAL_TLS=true
TEMPORAL_BRIDGE=postgres
RUN_CRON=true
IS_GENERAL=true
DISABLE_REGISTRATION=false
SOURCE_CODE_URL=https://github.com/AutonomousBusinessUnits/postiz
